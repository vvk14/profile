# Copy this file to .env.local and fill in real values.
# Until these are set, the contact form and review system work end-to-end
# but log to the console instead of writing to your Google Sheet / sending email.
# See SETUP.md for step-by-step instructions.

# The Web App URL you get after deploying apps-script/Code.gs
GOOGLE_SCRIPT_URL=

# Any long random string, must match the SHARED_SECRET script property
# you set inside the Apps Script project. Prevents randoms on the internet
# from writing rows into your sheet.
GOOGLE_SCRIPT_SECRET=
